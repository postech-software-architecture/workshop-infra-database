        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\ntitle: workshop-infra-database — diagrama de componentes\n---\nflowchart TD\n\n    subgraph CICD[\&quot;CI/CD — GitHub Actions\&quot;]\n        CI[\&quot;ci.yml&lt;br/&gt;fmt + validate + lint\&quot;]\n        PLAN[\&quot;terraform-plan.yml\&quot;]\n        APPLY[\&quot;terraform-apply.yml\&quot;]\n        DESTROY[\&quot;terraform-destroy.yml\&quot;]\n\n        subgraph SCRIPTS[\&quot;.github/scripts — guard rails\&quot;]\n            S1[\&quot;preflight-backend.sh\&quot;]\n            S2[\&quot;read-cluster-output.sh&lt;br/&gt;(+ test-read-cluster-output.sh)\&quot;]\n            S3[\&quot;check-resource-boundary.sh&lt;br/&gt;(nenhum recurso de EKS — gate G3)\&quot;]\n            S4[\&quot;validate-plan.sh\&quot;]\n            S5[\&quot;inventory-database.sh&lt;br/&gt;(read-only pre-apply)\&quot;]\n            S6[\&quot;validate-aws-database.sh\&quot;]\n        end\n    end\n\n    subgraph CONTRACT[\&quot;Contrato de entrada (read-only)\&quot;]\n        RS[\&quot;data.terraform_remote_state.cluster&lt;br/&gt;backend s3 — key cluster/terraform.tfstate&lt;br/&gt;count = use_remote_state ? 1 : 0\&quot;]\n        FB[\&quot;Fallback vars&lt;br/&gt;vpc_id_fallback&lt;br/&gt;private_subnet_ids_fallback&lt;br/&gt;db_client_sg_id_fallback&lt;br/&gt;(artifact contracts/outputs.json)\&quot;]\n        LOC[\&quot;locals&lt;br/&gt;vpc_id&lt;br/&gt;private_subnet_ids&lt;br/&gt;db_client_sg_id\&quot;]\n    end\n\n    subgraph TF[\&quot;Terraform — state PROPRIO\&quot;]\n        PROV[\&quot;providers.tf — aws (var.region)\&quot;]\n        VARS[\&quot;variables.tf / terraform.tfvars.example&lt;br/&gt;engine_version, instance_class,&lt;br/&gt;allocated_storage, db_name,&lt;br/&gt;db_username, db_password (sensitive),&lt;br/&gt;janelas de backup/manutencao\&quot;]\n    end\n\n    subgraph AWS[\&quot;AWS — recursos gerenciados por este repo\&quot;]\n        SUBGRP[\&quot;aws_db_subnet_group.this&lt;br/&gt;workshop-db-subnets&lt;br/&gt;precondition: &gt;= 2 subnets privadas\&quot;]\n        SG[\&quot;aws_security_group.db&lt;br/&gt;workshop-db-sg&lt;br/&gt;ingress 5432 SOMENTE de db_client_sg_id&lt;br/&gt;sem CIDR aberto&lt;br/&gt;revoke_rules_on_delete\&quot;]\n        RDS[(\&quot;aws_db_instance.postgres&lt;br/&gt;workshop-db — PostgreSQL&lt;br/&gt;gp3, storage_encrypted&lt;br/&gt;max_allocated_storage = 2x&lt;br/&gt;publicly_accessible = false&lt;br/&gt;monitoring_interval = 0&lt;br/&gt;skip_final_snapshot\&quot;)]\n    end\n\n    OUT[\&quot;outputs.tf — CONTRATO de saida&lt;br/&gt;db_host, db_port, db_name,&lt;br/&gt;db_username, db_endpoint,&lt;br/&gt;db_security_group_id,&lt;br/&gt;db_instance_identifier\&quot;]\n\n    subgraph EXT[\&quot;Fora do escopo deste repo\&quot;]\n        CLUSTERREPO[\&quot;workshop-infra-kubernetes&lt;br/&gt;VPC, subnets, EKS, db_client_sg\&quot;]\n        NODES[\&quot;Nodes do EKS&lt;br/&gt;(workshop-service)\&quot;]\n        LAMBDA[\&quot;Lambda workshop-auth-cpf\&quot;]\n        AUTHREPO[\&quot;workshop-auth-serverless&lt;br/&gt;le db_host/port/name/username\&quot;]\n    end\n\n    CI --&gt; PLAN --&gt; APPLY\n    APPLY --&gt; DESTROY\n    SCRIPTS -.-&gt; PLAN\n    SCRIPTS -.-&gt; APPLY\n\n    CLUSTERREPO -.-&gt;|\&quot;remote state S3&lt;br/&gt;NUNCA escrito\&quot;| RS\n    RS --&gt; LOC\n    FB --&gt; LOC\n\n    LOC --&gt;|\&quot;private_subnet_ids\&quot;| SUBGRP\n    LOC --&gt;|\&quot;vpc_id + db_client_sg_id\&quot;| SG\n    PROV --&gt; AWS\n    VARS --&gt; RDS\n\n    SUBGRP --&gt; RDS\n    SG --&gt; RDS\n    RDS --&gt; OUT\n    SG --&gt; OUT\n\n    NODES --&gt;|\&quot;5432 via db_client_sg\&quot;| SG\n    LAMBDA --&gt;|\&quot;5432 via db_client_sg\&quot;| SG\n    OUT -.-&gt; AUTHREPO\n\n    classDef ci fill:#e8e4fa,stroke:#8b7fd4,color:#000\n    classDef tf fill:#e3f0fd,stroke:#6a9ad4,color:#000\n    classDef aws fill:#fdf3e3,stroke:#d4a96a,color:#000\n    classDef db fill:#d9f5f0,stroke:#5aa89c,color:#000\n    classDef ext fill:#f0f0f0,stroke:#999,color:#000\n\n    class CI,PLAN,APPLY,DESTROY,S1,S2,S3,S4,S5,S6 ci\n    class RS,FB,LOC,PROV,VARS,OUT tf\n    class SUBGRP,SG aws\n    class RDS db\n    class CLUSTERREPO,NODES,LAMBDA,AUTHREPO ext\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="51">
